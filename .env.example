# Resend API key (required) — https://resend.com/api-keys
RESEND_API_KEY=

# Where to deliver waitlist notifications. Defaults to contact@getenclave.ai.
WAITLIST_TO=contact@getenclave.ai

# From-address shown on the notification + confirmation emails.
# Must be an address on a domain you have verified in Resend.
WAITLIST_FROM=Enclave Waitlist <no-reply@getenclave.ai>

# Public site URL used for links and the logo in confirmation emails.
# Must be the host that serves assets DIRECTLY (no redirect) — Gmail does not
# follow 307s on <img> sources, which breaks the logo. Default is the www host.
NEXT_PUBLIC_SITE_URL=https://www.getenclave.ai

# Cal.com (or equivalent) link included in the confirmation email as the
# "Book a call" CTA. Defaults to shashank-bhardwaj-fwmii1/30min.
WAITLIST_CALL_URL=https://cal.com/shashank-bhardwaj-fwmii1/30min
